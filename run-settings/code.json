{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(./**)",
      "Write(./**)",
      "Bash(nix develop --command:*)",
      "Bash(nix flake check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "WebSearch",
      "WebFetch",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  }
}
