# Copy to /etc/claude-kanban/serv.env on serv.

# The vault's claude/ folder as livesync-bridge writes it to disk
CLAUDE_DIR=/srv/livesync-bridge/data/claude

# The PC
PC_HOST=pc                      # LAN or Tailscale name that resolves to the PC
PC_MAC=aa:bb:cc:dd:ee:ff        # wired NIC
WAKE_TIMEOUT=120                # seconds to wait for SSH after the wake packet
TRIGGER_KEY=/home/boardsync/.ssh/board-trigger   # restricted key on the PC: starts claude-kanban@now only

# Seconds to wait after a change before checking, so a card being typed on the phone settles
DEBOUNCE=20

# Home Assistant webhook for "report ready" (see ha/automation.yaml)
HA_URL=http://homeassistant.local:8123
HA_WEBHOOK_ID=claude-kanban-report
