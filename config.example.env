# Copy to ~/.config/claude-kanban/config.env (install.sh does this once) and adjust.

# Where the PC keeps its copy of the vault's claude/ folder and the run state
BOARD_HOME="$HOME/board"
VAULT_DIR="$BOARD_HOME/vault"
CODE_DIR="$HOME/code"

# Sync with serv over SSH. The key is restricted to the board folder with rrsync on serv.
SYNC=rsync                     # rsync | none (none = work on VAULT_DIR only, for testing)
SERV_SSH="boardsync@serv"
SERV_KEY="$HOME/.ssh/board-sync"

# Claude runs
CLAUDE_BIN=claude
YQ=yq                          # mikefarah yq (nixpkgs: yq-go)
BOARD_MODEL=sonnet             # model for board runs; pick one that needs no usage credits
TASK_TIMEOUT=45m               # per card
MAX_TURNS=80
SANDBOX=systemd                # systemd | none (none = no InaccessiblePaths, testing only)

# Usage cap: percent of the account's weekly limit. Includes your own Claude use elsewhere.
CAP_WEEKLY=60
USAGE_UNKNOWN=allow            # allow | deny, when no usage data can be found
